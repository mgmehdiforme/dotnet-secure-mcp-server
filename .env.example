# Copy to .env and fill in. Never commit .env.
# Create a key + hash with:  dotnet run --project src/SecureMcp.Server -- new-key claude-desktop orders.read
McpSecurity__ApiKeys__0__Id=claude-desktop
McpSecurity__ApiKeys__0__Sha256=replace-with-the-64-char-sha256-from-new-key
McpSecurity__ApiKeys__0__Scopes__0=orders.read

# Host names clients use to reach the server (anything else gets 403).
McpSecurity__AllowedHosts__0=localhost
McpSecurity__AllowedHosts__1=127.0.0.1

# Optional: send traces and metrics to any OTLP collector (Aspire dashboard, Jaeger, Grafana...).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
